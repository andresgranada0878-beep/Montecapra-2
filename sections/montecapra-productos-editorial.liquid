{% liquid
  assign product_limit = section.settings.product_count | default: 4 | plus: 0
  assign desktop_columns = section.settings.desktop_columns | default: '4'
%}

{% if section.settings.collection != blank %}
  <section
    id="MontecapraProducts-{{ section.id }}"
    class="montecapra-editorial"
    {% if section.settings.heading != blank %}aria-labelledby="MontecapraProductsHeading-{{ section.id }}"{% endif %}
    style="--montecapra-editorial-bg: {{ section.settings.section_background }}; --montecapra-editorial-card-bg: {{ section.settings.card_background }}; --montecapra-editorial-text: {{ section.settings.text_color }}; --montecapra-editorial-button: {{ section.settings.button_color }}; --montecapra-editorial-columns: {{ desktop_columns }}; --montecapra-editorial-radius: {{ section.settings.card_radius }}px;"
  >
    <div class="montecapra-editorial__container">
      {% if section.settings.heading != blank %}
        <header class="montecapra-editorial__header">
          <h2 class="montecapra-editorial__heading" id="MontecapraProductsHeading-{{ section.id }}">
            {{ section.settings.heading | escape }}
          </h2>
        </header>
      {% endif %}

      <ul class="montecapra-editorial__grid" role="list">
        {% for product in section.settings.collection.products limit: product_limit %}
          {% liquid
            assign featured_image = product.featured_image
            assign secondary_image = product.images[1]
            assign image_alt = featured_image.alt | default: product.title
            assign product_subtitle = product.metafields.custom.subtitulo_producto.value
            assign badge_label = blank

            if section.settings.show_badge
              if product.available == false
                assign badge_label = 'Agotado'
              elsif product.compare_at_price > product.price
                assign badge_label = 'Oferta'
              else
                for product_tag in product.tags
                  assign normalized_tag = product_tag | downcase | strip
                  if normalized_tag == 'nuevo' or normalized_tag == 'nuevo lanzamiento' or normalized_tag == 'premium' or normalized_tag == 'edición limitada' or normalized_tag == 'edicion limitada' or normalized_tag == 'favorito' or normalized_tag == 'más vendido' or normalized_tag == 'mas vendido'
                    assign badge_label = product_tag
                    break
                  endif
                endfor
              endif
            endif
          %}

          <li class="montecapra-editorial__grid-item">
            <article class="montecapra-editorial__card">
              <a class="montecapra-editorial__media{% if secondary_image != blank %} montecapra-editorial__media--has-secondary{% endif %}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if featured_image != blank %}
                  {{
                    featured_image
                    | image_url: width: 1800
                    | image_tag:
                      widths: '360, 540, 720, 900, 1200, 1500, 1800',
                      sizes: '(min-width: 1400px) 320px, (min-width: 990px) 30vw, (min-width: 750px) 46vw, calc(100vw - 32px)',
                      loading: 'lazy',
                      alt: image_alt,
                      class: 'montecapra-editorial__image'
                  }}
                {% endif %}

                {% if secondary_image != blank %}
                  {{
                    secondary_image
                    | image_url: width: 1800
                    | image_tag:
                      widths: '360, 540, 720, 900, 1200, 1500, 1800',
                      sizes: '(min-width: 1400px) 320px, (min-width: 990px) 30vw, (min-width: 750px) 46vw, calc(100vw - 32px)',
                      loading: 'lazy',
                      alt: '',
                      class: 'montecapra-editorial__image montecapra-editorial__image--secondary'
                  }}
                {% endif %}

                {% if badge_label != blank %}
                  <span class="montecapra-editorial__badge">{{ badge_label | escape }}</span>
                {% endif %}
              </a>

              <div class="montecapra-editorial__content">
                <h3 class="montecapra-editorial__product-title">
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </h3>

                {% if product_subtitle != blank %}
                  <p class="montecapra-editorial__subtitle">{{ product_subtitle | escape }}</p>
                {% endif %}

                {% if section.settings.show_price %}
                  <div class="montecapra-editorial__price">
                    {% if product.compare_at_price > product.price %}
                      <s class="montecapra-editorial__compare-price">{{ product.compare_at_price | money }}</s>
                    {% endif %}
                    <span>{{ product.price | money }}</span>
                  </div>
                {% endif %}

                {% if section.settings.show_coffee_info %}
                  {% liquid
                    assign region = product.metafields.montecapra.origen.value
                    assign altitude = product.metafields.montecapra.altura.value
                    assign tasting_notes = product.metafields.montecapra.notas_cata.value
                    assign process = product.metafields.montecapra.proceso.value
                    assign variety = product.metafields.montecapra.variedad.value
                    assign cup_profile = product.metafields.montecapra.perfil.value
                    assign intensity = product.metafields.custom.intensidad.value
                    assign recommended_for = product.metafields.custom.recomendado_para.value
                    assign coffee_story = product.metafields.montecapra.historia.value
                  %}
                  {% if region != blank or altitude != blank or tasting_notes != blank or process != blank or variety != blank or cup_profile != blank or intensity != blank or recommended_for != blank or coffee_story != blank %}
                    {% if region != blank or altitude != blank or variety != blank or cup_profile != blank or tasting_notes != blank or process != blank or intensity != blank or recommended_for != blank %}
                      <dl class="montecapra-editorial__facts">
                      {% if region != blank %}
                        <div class="montecapra-editorial__fact"><dt>Origen</dt><dd>{{ region | escape }}</dd></div>
                      {% endif %}
                      {% if altitude != blank %}
                        <div class="montecapra-editorial__fact"><dt>Altitud</dt><dd>{{ altitude | escape }}</dd></div>
                      {% endif %}
                      {% if variety != blank %}
                        <div class="montecapra-editorial__fact"><dt>Variedad</dt><dd>{{ variety | escape }}</dd></div>
                      {% endif %}
                      {% if cup_profile != blank %}
                        <div class="montecapra-editorial__fact"><dt>Perfil de taza</dt><dd>{{ cup_profile | escape }}</dd></div>
                      {% endif %}
                      {% if tasting_notes != blank %}
                        <div class="montecapra-editorial__fact"><dt>Notas de cata</dt><dd>{{ tasting_notes | escape }}</dd></div>
                      {% endif %}
                      {% if process != blank %}
                        <div class="montecapra-editorial__fact"><dt>Proceso</dt><dd>{{ process | escape }}</dd></div>
                      {% endif %}
                      {% if intensity != blank %}
                        <div class="montecapra-editorial__fact"><dt>Intensidad</dt><dd>{{ intensity | escape }}</dd></div>
                      {% endif %}
                      {% if recommended_for != blank %}
                        <div class="montecapra-editorial__fact"><dt>Ideal para</dt><dd>{{ recommended_for | escape }}</dd></div>
                      {% endif %}
                      </dl>
                    {% endif %}
                    {% if coffee_story != blank %}
                      <dl class="montecapra-editorial__facts">
                        <div class="montecapra-editorial__fact">
                          <dt>Historia del café</dt>
                          <dd>{{ coffee_story | escape }}</dd>
                        </div>
                      </dl>
                    {% endif %}
                  {% endif %}
                {% endif %}

                {% if section.settings.show_button and section.settings.button_label != blank %}
                  <a class="montecapra-editorial__button" href="{{ product.url }}">{{ section.settings.button_label | escape }}</a>
                {% endif %}
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}


{% style %}
  #MontecapraProducts-{{ section.id }} {
    --montecapra-editorial-bg: {{ section.settings.section_background }};
    --montecapra-editorial-card-bg: {{ section.settings.card_background }};
    --montecapra-editorial-text: {{ section.settings.text_color }};
    --montecapra-editorial-button: {{ section.settings.button_color }};
    --montecapra-editorial-columns: {{ section.settings.desktop_columns }};
    --montecapra-editorial-radius: {{ section.settings.card_radius }}px;
    padding: 80px 24px;
    background: var(--montecapra-editorial-bg, #f7f4ef);
    color: var(--montecapra-editorial-text, #23160f);
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__container {
    max-width: 1500px;
    margin: 0 auto;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__header {
    margin-bottom: 42px;
    text-align: center;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__heading {
    margin: 0;
    color: inherit;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.2;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid {
    display: grid;
    grid-template-columns: repeat(var(--montecapra-editorial-columns, 4), minmax(0, 1fr));
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--montecapra-editorial-radius, 28px);
    background: var(--montecapra-editorial-card-bg, #fff);
    box-shadow: 0 8px 28px rgba(35, 22, 15, 0.06);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #eee9e1;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.65, 0.3, 1);
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 350ms ease;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 8px 11px;
    border-radius: 999px;
    background: rgba(35, 22, 15, 0.92);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__content {
    display: flex;
    height: 100%;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 26px 24px 26px;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__product-title {
    margin: 0;
    color: inherit;
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__product-title a {
    color: inherit;
    text-decoration: none;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__subtitle {
    margin: 4px 0 0;
    color: #85734f;
    font-size: 13px;
    line-height: 1.45;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__price {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    align-items: baseline;
    margin-top: 18px;
    margin-bottom: 22px;
    color: var(--montecapra-editorial-button, #23160f);
    font-size: 19px;
    font-weight: 700;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__compare-price {
    color: #857d73;
    font-size: 14px;
    font-weight: 400;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__facts {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 20px;
    margin: 0 0 22px;
    padding: 22px;
    border-radius: 18px;
    background: #f6efe4;
    transition: box-shadow 220ms ease, transform 220ms ease;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__facts:hover {
    box-shadow: 0 8px 20px rgba(35, 22, 15, 0.08);
    transform: translateY(-2px);
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact {
    min-width: 0;
    padding: 0;
    border-radius: 0;
    background: transparent;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact dt {
    color: #8a7452;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact dd {
    margin: 4px 0 0;
    color: #2c1c12;
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding: 12px 24px;
    border: 1px solid var(--montecapra-editorial-button, #23160f);
    border-radius: 999px;
    background: var(--montecapra-editorial-button, #23160f);
    color: #fff;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-align: center;
    text-decoration: none;
    transition: background-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__button:hover {
    transform: translateY(-2px);
    background: #49352a;
    box-shadow: 0 6px 16px rgba(35, 22, 15, 0.14);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 34px rgba(35, 22, 15, 0.1);
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__card:hover .montecapra-editorial__image {
      transform: scale(1.035);
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__media--has-secondary:hover .montecapra-editorial__image--secondary {
      opacity: 1;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__media--has-secondary:hover .montecapra-editorial__image:not(.montecapra-editorial__image--secondary) {
      opacity: 0;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #MontecapraProducts-{{ section.id }} {
      padding: 52px 16px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__header {
      margin-bottom: 28px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__heading {
      font-size: 26px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__product-title {
      font-size: 18px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      margin-bottom: 16px;
      padding: 16px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact dd {
      font-size: 14px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__content {
      padding: 20px 18px 22px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__price {
      font-size: 17px;
      margin-bottom: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__card,
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__image,
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__image--secondary,
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__button {
      transition: none;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__image--secondary {
      display: none;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__card:hover,
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__card:hover .montecapra-editorial__image,
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__button:hover {
      transform: none;
    }
  }
{% endstyle %}


{% schema %}
{
  "name": "Productos Montecapra",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título de sección",
      "default": "Cafés de origen"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "select",
      "id": "product_count",
      "label": "Productos visibles",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Columnas de escritorio",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Mostrar precio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_coffee_info",
      "label": "Mostrar información del café",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Mostrar botón",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Mostrar etiquetas",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubrir café"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Fondo de sección",
      "default": "#F7F4EF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fondo de tarjeta",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#23160F"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Color del botón",
      "default": "#23160F"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio de tarjeta",
      "min": 24,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Productos MonteCapra"
    }
  ]
}
{% endschema %}