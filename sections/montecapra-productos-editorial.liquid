{% liquid
  assign product_limit = section.settings.product_count | default: 5 | plus: 0
  assign desktop_columns = section.settings.desktop_columns | default: '5'
%}

{% if section.settings.collection != blank %}
  <section
    id="MontecapraProducts-{{ section.id }}"
    class="montecapra-editorial"
    {% if section.settings.heading != blank %}aria-labelledby="MontecapraProductsHeading-{{ section.id }}"{% endif %}
    style="--montecapra-editorial-bg: {{ section.settings.section_background }}; --montecapra-editorial-card-bg: {{ section.settings.card_background }}; --montecapra-editorial-text: {{ section.settings.text_color }}; --montecapra-editorial-button: {{ section.settings.button_color }}; --montecapra-editorial-columns: {{ desktop_columns }}; --montecapra-editorial-radius: {{ section.settings.card_radius }}px;"
  >
    <div class="montecapra-editorial__container">
      {% if section.settings.heading != blank %}
        <header class="montecapra-editorial__header">
          <h2 class="montecapra-editorial__heading" id="MontecapraProductsHeading-{{ section.id }}">
            {{ section.settings.heading | escape }}
          </h2>
        </header>
      {% endif %}

      <div class="montecapra-editorial-viewport">
        <ul class="montecapra-editorial__grid" role="list">
          {% for product in section.settings.collection.products limit: product_limit %}
            {% liquid
              assign featured_image = product.featured_image
              assign secondary_image = product.images[1]
              assign image_alt = featured_image.alt | default: product.title
              assign product_subtitle = product.metafields.custom.subtitulo_producto.value
              assign badge_label = blank

              if section.settings.show_badge
                if product.available == false
                  assign badge_label = 'Agotado'
                elsif product.compare_at_price > product.price
                  assign badge_label = 'Oferta'
                else
                  for product_tag in product.tags
                    assign normalized_tag = product_tag | downcase | strip
                    if normalized_tag == 'nuevo' or normalized_tag == 'nuevo lanzamiento' or normalized_tag == 'premium' or normalized_tag == 'edición limitada' or normalized_tag == 'edicion limitada' or normalized_tag == 'favorito' or normalized_tag == 'más vendido' or normalized_tag == 'mas vendido'
                      assign badge_label = product_tag
                      break
                    endif
                  endfor
                endif
              endif
            %}

            <li class="montecapra-editorial__grid-item">
              <article class="montecapra-editorial__card">
                <a class="montecapra-editorial__media{% if secondary_image != blank %} montecapra-editorial__media--has-secondary{% endif %}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  {% if featured_image != blank %}
                    {{
                      featured_image
                      | image_url: width: 1800
                      | image_tag:
                        widths: '360, 540, 720, 900, 1200, 1500, 1800',
                        sizes: '(min-width: 1400px) 320px, (min-width: 990px) 26vw, (min-width: 750px) 46vw, calc(100vw - 32px)',
                        loading: 'lazy',
                        alt: image_alt,
                        class: 'montecapra-editorial__image'
                    }}
                  {% endif %}

                  {% if secondary_image != blank %}
                    {{
                      secondary_image
                      | image_url: width: 1800
                      | image_tag:
                        widths: '360, 540, 720, 900, 1200, 1500, 1800',
                        sizes: '(min-width: 1400px) 320px, (min-width: 990px) 26vw, (min-width: 750px) 46vw, calc(100vw - 32px)',
                        loading: 'lazy',
                        alt: '',
                        class: 'montecapra-editorial__image montecapra-editorial__image--secondary'
                    }}
                  {% endif %}

                  {% if badge_label != blank %}
                    <span class="montecapra-editorial__badge">{{ badge_label | escape }}</span>
                  {% endif %}
                </a>

                <div class="montecapra-editorial__content">
                  <h3 class="montecapra-editorial__product-title">
                    <a href="{{ product.url }}">{{ product.title | escape }}</a>
                  </h3>

                  {% if product_subtitle != blank %}
                    <p class="montecapra-editorial__subtitle">{{ product_subtitle | escape }}</p>
                  {% endif %}

                  {% if section.settings.show_price %}
                    <div class="montecapra-editorial__price">
                      {% if product.compare_at_price > product.price %}
                        <s class="montecapra-editorial__compare-price">{{ product.compare_at_price | money }}</s>
                      {% endif %}
                      <span>{{ product.price | money }}</span>
                    </div>
                  {% endif %}

                  {% if section.settings.show_coffee_info %}
                    {% liquid
                      assign region = product.metafields.montecapra.origen.value
                      assign altitude = product.metafields.montecapra.altura.value
                      assign tasting_notes = product.metafields.montecapra.notas_cata.value
                      assign process = product.metafields.montecapra.proceso.value
                      assign variety = product.metafields.montecapra.variedad.value
                      assign cup_profile_val = product.metafields.montecapra.perfil.value
                    %}
                    {% if region != blank or altitude != blank or tasting_notes != blank or process != blank or variety != blank or cup_profile_val != blank %}
                      <div class="montecapra-editorial__facts-wrapper">
                        <dl class="montecapra-editorial__facts">
                        {% if region != blank %}
                          <div class="montecapra-editorial__fact">
                            <span class="montecapra-editorial__fact-icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            </span>
                            <div class="montecapra-editorial__fact-text">
                              <dt>Origen</dt>
                              <dd>{{ region | escape }}</dd>
                            </div>
                          </div>
                        {% endif %}
                        {% if altitude != blank %}
                          <div class="montecapra-editorial__fact">
                            <span class="montecapra-editorial__fact-icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z"></path></svg>
                            </span>
                            <div class="montecapra-editorial__fact-text">
                              <dt>Altitud</dt>
                              <dd>{{ altitude | escape }}</dd>
                            </div>
                          </div>
                        {% endif %}
                        {% if variety != blank %}
                          <div class="montecapra-editorial__fact">
                            <span class="montecapra-editorial__fact-icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                            </span>
                            <div class="montecapra-editorial__fact-text">
                              <dt>Variedad</dt>
                              <dd>{{ variety | escape }}</dd>
                            </div>
                          </div>
                        {% endif %}
                        {% if cup_profile_val != blank %}
                          <div class="montecapra-editorial__fact">
                            <span class="montecapra-editorial__fact-icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
                            </span>
                            <div class="montecapra-editorial__fact-text">
                              <dt>Perfil de taza</dt>
                              <dd>{{ cup_profile_val | escape }}</dd>
                            </div>
                          </div>
                        {% endif %}
                        {% if tasting_notes != blank %}
                          <div class="montecapra-editorial__fact">
                            <span class="montecapra-editorial__fact-icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                            </span>
                            <div class="montecapra-editorial__fact-text">
                              <dt>Notas de cata</dt>
                              <dd>{{ tasting_notes | escape }}</dd>
                            </div>
                          </div>
                        {% endif %}
                        {% if process != blank %}
                          <div class="montecapra-editorial__fact">
                            <span class="montecapra-editorial__fact-icon" aria-hidden="true">
                              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                            </span>
                            <div class="montecapra-editorial__fact-text">
                              <dt>Proceso</dt>
                              <dd>{{ process | escape }}</dd>
                            </div>
                          </div>
                        {% endif %}
                        </dl>
                      </div>
                    {% endif %}
                  {% endif %}

                  {% if section.settings.show_button and section.settings.button_label != blank %}
                    <a class="montecapra-editorial__button" href="{{ product.url }}">{{ section.settings.button_label | escape }} <span>→</span></a>
                  {% endif %}
                </div>
              </article>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </section>
{% endif %}


{% style %}
  #MontecapraProducts-{{ section.id }} {
    --montecapra-editorial-bg: {{ section.settings.section_background }};
    --montecapra-editorial-card-bg: {{ section.settings.card_background }};
    --montecapra-editorial-text: {{ section.settings.text_color }};
    --montecapra-editorial-button: {{ section.settings.button_color }};
    --montecapra-editorial-columns: {{ section.settings.desktop_columns }};
    --montecapra-editorial-radius: {{ section.settings.card_radius }}px;
    padding: 10px 24px 60px 24px;
    background: var(--montecapra-editorial-bg, #f7f4ef);
    color: var(--montecapra-editorial-text, #23160f);
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__container {
    max-width: 1750px;
    margin: 0 auto;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__header {
    margin-bottom: 36px;
    text-align: center;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* CONTENEDOR HORIZONTAL FLUIDO CON INERCIA Y SCROLL NATIVO PREMIUM */
  #MontecapraProducts-{{ section.id }} .montecapra-editorial-viewport {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding-bottom: 12px;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 32px;
    margin: 0;
    padding: 10px 4px 20px 4px;
    list-style: none;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(35, 22, 15, 0.2) transparent;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid::-webkit-scrollbar {
    height: 6px;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid::-webkit-scrollbar-thumb {
    background: rgba(35, 22, 15, 0.25);
    border-radius: 999px;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid-item {
    flex: 0 0 320px;
    scroll-snap-align: start;
    min-width: 0;
  }

  @media screen and (min-width: 1200px) {
    #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid-item {
      flex: 0 0 calc((100% - (4 * 32px)) / 5);
    }
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__card {
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: var(--montecapra-editorial-radius, 28px);
    background: var(--montecapra-editorial-card-bg, #fff);
    box-shadow: 0 12px 35px rgba(35, 22, 15, 0.06);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 45px rgba(35, 22, 15, 0.12);
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #eee9e1;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__card:hover .montecapra-editorial__image {
    transform: scale(1.04);
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__media--has-secondary:hover .montecapra-editorial__image--secondary {
    opacity: 1;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__media--has-secondary:hover .montecapra-editorial__image:not(.montecapra-editorial__image--secondary) {
    opacity: 0;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(35, 22, 15, 0.92);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__content {
    display: flex;
    height: 100%;
    flex: 1;
    flex-direction: column;
    padding: 24px 20px 24px;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__product-title {
    margin: 0;
    color: inherit;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__product-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__product-title a:hover {
    color: #A87845;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__subtitle {
    margin: 4px 0 0;
    color: #85734f;
    font-size: 12.5px;
    line-height: 1.4;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__price {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    margin-top: 12px;
    margin-bottom: 18px;
    color: var(--montecapra-editorial-button, #23160f);
    font-size: 17px;
    font-weight: 800;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__compare-price {
    color: #857d73;
    font-size: 13px;
    font-weight: 400;
  }

  /* CAJITA DE ESPECIFICACIONES TÉCNICAS */
  #MontecapraProducts-{{ section.id }} .montecapra-editorial__facts-wrapper {
    width: 100%;
    margin-bottom: 20px;
    padding: 12px;
    border-radius: 16px;
    background: #f6efe4;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    padding: 10px 10px;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(35, 22, 15, 0.03);
    min-width: 0;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    background: rgba(138, 116, 82, 0.12);
    color: #8a7452;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact dt {
    color: #8a7452;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__fact dd {
    margin: 2px 0 0;
    color: #2c1c12;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    margin-top: auto;
    padding: 12px 20px;
    border: none;
    border-radius: 999px;
    background: var(--montecapra-editorial-button, #23160f);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    transition: transform 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease;
  }

  #MontecapraProducts-{{ section.id }} .montecapra-editorial__button:hover {
    transform: translateY(-2px);
    opacity: 0.94;
    box-shadow: 0 6px 16px rgba(35, 22, 15, 0.15);
  }

  @media screen and (max-width: 749px) {
    #MontecapraProducts-{{ section.id }} {
      padding: 10px 16px 40px 16px;
    }

    #MontecapraProducts-{{ section.id }} .montecapra-editorial__grid-item {
      flex: 0 0 285px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Productos Montecapra",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título de sección",
      "default": "Cafés de origen"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "select",
      "id": "product_count",
      "label": "Productos visibles",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "5"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Columnas de escritorio",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "5"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Mostrar precio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_coffee_info",
      "label": "Mostrar información del café",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Mostrar botón",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Mostrar etiquetas",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Descubrir café"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Fondo de sección",
      "default": "#F7F4EF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fondo de tarjeta",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#23160F"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Color del botón",
      "default": "#173C2A"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Radio de tarjeta",
      "min": 24,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Productos MonteCapra"
    }
  ]
}
{% endschema %}