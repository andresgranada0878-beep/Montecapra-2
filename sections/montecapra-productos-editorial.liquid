{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<section class="section montecapra-productos">
  <div class="page-width montecapra-productos__container">

    {% if section.settings.titulo != blank %}
      <h2 class="montecapra-productos__title">
        {{ section.settings.titulo }}
      </h2>
    {% endif %}

    {% if section.settings.collection != blank %}
      <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">

        {% for producto in section.settings.collection.products %}

          <li class="grid__item">

            {% render 'card-product',
              card_product: producto,
              section_id: section.id,
              show_secondary_image: true,
              show_vendor: false,
              show_rating: false
            %}

            {% liquid
              assign region = producto.metafields.custom.region.value
              assign altitud = producto.metafields.custom.altitud.value
              assign notas = producto.metafields.custom.notas_cata.value
              assign proceso = producto.metafields.custom.proceso.value
            %}

            {% if region != blank or altitud != blank or notas != blank or proceso != blank %}

              <div class="montecapra-productos__facts">

                {% if region != blank %}
                  <div>
                    <span>Región</span>
                    <p>{{ region }}</p>
                  </div>
                {% endif %}

                {% if altitud != blank %}
                  <div>
                    <span>Altitud</span>
                    <p>{{ altitud }}</p>
                  </div>
                {% endif %}

                {% if notas != blank %}
                  <div>
                    <span>Notas de cata</span>
                    <p>{{ notas }}</p>
                  </div>
                {% endif %}

                {% if proceso != blank %}
                  <div>
                    <span>Proceso</span>
                    <p>{{ proceso }}</p>
                  </div>
                {% endif %}

              </div>

            {% endif %}

          </li>

        {% endfor %}

      </ul>
    {% endif %}

  </div>
</section>


{% stylesheet %}

.montecapra-productos {
  background: #faf8f3;
  padding-top: 80px;
  padding-bottom: 80px;
}

.montecapra-productos__container {
  max-width: 1400px;
}

.montecapra-productos__title {
  margin-bottom: 40px;
  color: #23160f;
}


.montecapra-productos .product-grid {
  row-gap: 40px;
  column-gap: 32px;
}


.montecapra-productos .card {
  border-radius: 24px;
  overflow: hidden;
  background: white;
  box-shadow: 0 8px 24px rgba(35,22,15,.08);
}


.montecapra-productos .card__content {
  padding: 18px;
}


.montecapra-productos__facts {

  margin-top: 18px;
  padding: 18px;

  background: #fff;
  border-radius: 0 0 20px 20px;

  display: grid;
  gap: 14px;

}


.montecapra-productos__facts span {

  color:#85734f;

  font-size:10px;

  text-transform:uppercase;

  letter-spacing:.1em;

  font-weight:600;

}


.montecapra-productos__facts p {

  margin:4px 0 0;

  color:#49352a;

  font-size:14px;

}


@media screen and (max-width:749px){

  .montecapra-productos{

    padding-top:50px;

    padding-bottom:50px;

  }


  .montecapra-productos .product-grid{

    column-gap:16px;

  }

}


{% endstylesheet %}


{% schema %}
{
  "name": "Productos MonteCapra",
  "settings": [
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Nuestros cafés"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    }
  ],
  "presets": [
    {
      "name": "Productos MonteCapra"
    }
  ]
}
{% endschema %}