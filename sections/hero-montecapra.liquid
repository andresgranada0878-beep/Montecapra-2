{% if section.blocks.size > 0 %}
  <section
    id="MontecapraHero-{{ section.id }}"
    class="montecapra-hero"
  >
    <div class="montecapra-hero__container">
      <montecapra-hero-slideshow class="montecapra-hero__frame" data-section-id="{{ section.id }}" style="--hero-height: {{ section.settings.hero_height }}px;">
        <div class="montecapra-hero__slides" id="MontecapraHeroSlides-{{ section.id }}" aria-live="polite">
          {% for block in section.blocks %}
            {% liquid
              assign hero_image = block.settings.image_desktop | default: block.settings.image_mobile
              assign hero_image_alt = block.settings.image_desktop.alt | default: block.settings.image_mobile.alt
              assign image_loading = 'lazy'
              if forloop.first
                assign image_loading = 'eager'
              endif
            %}
            <article
              class="montecapra-hero__slide{% if forloop.first %} is-active{% endif %}"
              data-hero-slide
              data-content-position="{{ block.settings.content_position }}"
              aria-roledescription="slide"
              aria-label="{{ forloop.index }} de {{ section.blocks.size }}"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
              {% unless forloop.first %}inert{% endunless %}
              {{ block.shopify_attributes }}
            >
              <div class="montecapra-hero__media" aria-hidden="true">
                {% if block.settings.video != blank %}
                  {{
                    block.settings.video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      preload: 'metadata',
                      class: 'montecapra-hero__video'
                  }}
                {% elsif hero_image != blank %}
                  <picture>
                    {% if block.settings.image_mobile != blank %}
                      <source
                        media="(max-width: 749px)"
                        srcset="{{ block.settings.image_mobile | image_url: width: 900 }}"
                      >
                    {% endif %}
                    {{
                      hero_image
                      | image_url: width: 2400
                      | image_tag:
                        widths: '375, 550, 750, 900, 1100, 1500, 2000, 2400',
                        sizes: '(min-width: 1532px) 1500px, calc(100vw - 32px)',
                        loading: image_loading,
                        alt: hero_image_alt,
                        class: 'montecapra-hero__image'
                    }}
                  </picture>
                {% endif %}
              </div>

              <div class="montecapra-hero__shade"></div>
              <div class="montecapra-hero__content" data-content-position="{{ block.settings.content_position }}">
                <div class="montecapra-hero__content-inner">
                  {% if block.settings.title != blank %}
                    {% if forloop.first %}
                      <h1 class="montecapra-hero__title">{{ block.settings.title | escape }}</h1>
                    {% else %}
                      <h2 class="montecapra-hero__title">{{ block.settings.title | escape }}</h2>
                    {% endif %}
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <div class="montecapra-hero__text rte">{{ block.settings.text }}</div>
                  {% endif %}

                  {% if block.settings.button_label != blank and block.settings.link != blank %}
                    <a class="montecapra-hero__button" href="{{ block.settings.link }}">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if section.blocks.size > 1 %}
          <div class="montecapra-hero__controls" aria-label="Controles del slideshow">
            <button class="montecapra-hero__arrow" type="button" data-hero-prev aria-label="Slide anterior">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <div class="montecapra-hero__pagination">
              {% for block in section.blocks %}
                <button
                  class="montecapra-hero__dot"
                  type="button"
                  data-hero-dot="{{ forloop.index0 }}"
                  aria-label="Ir a la diapositiva {{ forloop.index }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                ></button>
              {% endfor %}
            </div>
            <button class="montecapra-hero__arrow" type="button" data-hero-next aria-label="Slide siguiente">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        {% endif %}
      </montecapra-hero-slideshow>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .montecapra-hero {
    padding: 32px 24px 64px;
    background: #fff;
  }

  .montecapra-hero__container {
    max-width: 1500px;
    margin: 0 auto;
  }

  .montecapra-hero__frame {
    position: relative;
    display: block;
    height: var(--hero-height, 760px);
    overflow: hidden;
    border-radius: 32px;
    background: #23160f;
    color: #fff;
    isolation: isolate;
  }

  .montecapra-hero__slides,
  .montecapra-hero__slide,
  .montecapra-hero__media,
  .montecapra-hero__shade {
    position: absolute;
    inset: 0;
  }

  .montecapra-hero__slide {
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms ease, visibility 0s linear 500ms;
  }

  .montecapra-hero__slide.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    transition: opacity 500ms ease, visibility 0s;
  }

  .montecapra-hero__media,
  .montecapra-hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .montecapra-hero__image,
  .montecapra-hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .montecapra-hero__shade {
    z-index: 1;
    background: rgba(24, 16, 11, 0.28);
    pointer-events: none;
  }

  .montecapra-hero__content {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    padding: clamp(32px, 6vw, 88px);
    align-content: center;
    justify-items: start;
    text-align: left;
  }

  .montecapra-hero__content[data-content-position^='top-'] {
    align-content: start;
  }

  .montecapra-hero__content[data-content-position^='bottom-'] {
    align-content: end;
  }

  .montecapra-hero__content[data-content-position$='-center'] {
    justify-items: center;
    text-align: center;
  }

  .montecapra-hero__content[data-content-position$='-right'] {
    justify-items: end;
    text-align: right;
  }

  .montecapra-hero__content-inner {
    width: min(100%, 700px);
  }

  .montecapra-hero__title {
    max-width: 14ch;
    margin: 0 0 20px;
    color: inherit;
    font-size: 56px;
    font-weight: 400;
    line-height: 1.05;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.18);
  }

  .montecapra-hero__text {
    max-width: 560px;
    margin: 0 0 28px;
    color: inherit;
    font-size: 18px;
    line-height: 1.55;
  }

  .montecapra-hero__text > :first-child {
    margin-top: 0;
  }

  .montecapra-hero__text > :last-child {
    margin-bottom: 0;
  }

  .montecapra-hero__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border: 1px solid #fff;
    border-radius: 2px;
    background: #fff;
    color: #23160f;
    font-size: 14px;
    text-decoration: none;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .montecapra-hero__button:hover {
    background: transparent;
    color: #fff;
  }

  .montecapra-hero__controls {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    transform: translateX(-50%);
  }

  .montecapra-hero__arrow,
  .montecapra-hero__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.72);
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .montecapra-hero__arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }

  .montecapra-hero__arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .montecapra-hero__pagination {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .montecapra-hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .montecapra-hero__dot[aria-current='true'] {
    background: #fff;
  }

  .montecapra-hero__arrow:focus-visible,
  .montecapra-hero__dot:focus-visible,
  .montecapra-hero__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .montecapra-hero {
      padding: 20px 16px 40px;
    }

    .montecapra-hero__frame {
      height: min(var(--hero-height, 560px), 72vh);
      min-height: 460px;
      border-radius: 24px;
    }

    .montecapra-hero__content {
      padding: 28px 22px 76px;
    }

    .montecapra-hero__title {
      font-size: 40px;
    }

    .montecapra-hero__text {
      font-size: 16px;
    }

    .montecapra-hero__controls {
      bottom: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .montecapra-hero__button,
    .montecapra-hero__slide {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  if (!customElements.get('montecapra-hero-slideshow')) {
    class MontecapraHeroSlideshow extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('[data-hero-slide]'));
        this.dots = Array.from(this.querySelectorAll('[data-hero-dot]'));
        this.currentIndex = 0;

        if (this.slides.length < 2 || this.dataset.initialized === 'true') return;
        this.dataset.initialized = 'true';

        this.addEventListener('click', (event) => {
          const previous = event.target.closest('[data-hero-prev]');
          const next = event.target.closest('[data-hero-next]');
          const dot = event.target.closest('[data-hero-dot]');

          if (previous) this.showSlide(this.currentIndex - 1);
          if (next) this.showSlide(this.currentIndex + 1);
          if (dot) this.showSlide(Number(dot.dataset.heroDot));
        });

        this.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowLeft') this.showSlide(this.currentIndex - 1);
          if (event.key === 'ArrowRight') this.showSlide(this.currentIndex + 1);
        });

        this.showSlide(0);
      }

      showSlide(index) {
        this.currentIndex = (index + this.slides.length) % this.slides.length;

        this.slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === this.currentIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', String(!isActive));
          slide.inert = !isActive;

          const video = slide.querySelector('video');
          if (!video) return;

          if (!isActive || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            video.pause();
          } else {
            video.play().catch(() => {});
          }
        });

        this.dots.forEach((dot, dotIndex) => {
          dot.setAttribute('aria-current', String(dotIndex === this.currentIndex));
        });
      }
    }

    customElements.define('montecapra-hero-slideshow', MontecapraHeroSlideshow);
  }
</script>

{% schema %}
{
  "name": "Hero slideshow MC",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "hero_height",
      "min": 520,
      "max": 1000,
      "step": 40,
      "unit": "px",
      "label": "Altura del hero",
      "default": 760
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagen escritorio"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen móvil"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (opcional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Texto"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace del botón"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Posición del contenido",
          "options": [
            { "value": "top-left", "label": "Arriba izquierda" },
            { "value": "top-center", "label": "Arriba centro" },
            { "value": "top-right", "label": "Arriba derecha" },
            { "value": "middle-left", "label": "Centro izquierda" },
            { "value": "middle-center", "label": "Centro" },
            { "value": "middle-right", "label": "Centro derecha" },
            { "value": "bottom-left", "label": "Abajo izquierda" },
            { "value": "bottom-center", "label": "Abajo centro" },
            { "value": "bottom-right", "label": "Abajo derecha" }
          ],
          "default": "middle-left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow Montecapra"
    }
  ]
}
{% endschema %}