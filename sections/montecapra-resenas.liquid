{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.background_color | default: '#F7F4EF' }};
    color: {{ section.settings.text_color | default: '#23160F' }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .reviews-section-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Cabecera: Títulos y Poderes */
  .reviews-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .reviews-eyebrow {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    opacity: 0.7;
    margin-bottom: 0.8rem;
  }

  .reviews-main-title {
    font-size: 2.8rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .reviews-main-title {
      font-size: 3.8rem;
    }
  }

  /* Iconos de Beneficios ("Todos los poderes") */
  .powers-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    margin-top: 2.5rem;
    max-width: 1000px;
    margin-left: auto;
    margin-right: auto;
  }

  @media screen and (min-width: 750px) {
    .powers-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .power-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.6);
    padding: 1rem 1.2rem;
    border-radius: 14px;
    border: 1px solid rgba(107, 74, 47, 0.08);
  }

  .power-icon {
    width: 42px;
    height: 42px;
    background: {{ section.settings.accent_color | default: '#6B4A2F' }};
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }

  .power-text {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }

  /* Carrusel de Reseñas */
  .reviews-carousel-wrapper {
    position: relative;
    overflow: hidden;
    padding: 1rem 0;
  }

  .reviews-track {
    display: flex;
    gap: 2rem;
    transition: transform 0.4s ease-in-out;
    will-change: transform;
  }

  .review-card {
    background: {{ section.settings.card_background | default: '#FFFFFF' }};
    border-radius: 24px;
    padding: 2.5rem 2rem;
    box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    flex: 0 0 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(0,0,0,0.04);
  }

  @media screen and (min-width: 750px) {
    .review-card {
      flex: 0 0 calc(33.333% - 1.34rem);
    }
  }

  .review-stars {
    color: {{ section.settings.star_color | default: '#B8863B' }};
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
    letter-spacing: 2px;
  }

  .review-quote {
    font-size: 1.25rem;
    line-height: 1.6;
    font-weight: 500;
    margin-bottom: 2rem;
    opacity: 0.9;
    flex-grow: 1;
  }

  .review-author-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid rgba(0,0,0,0.06);
    padding-top: 1.5rem;
  }

  .review-avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
  }

  .review-author-name {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 0.2rem 0;
  }

  .review-verified {
    font-size: 0.9rem;
    opacity: 0.65;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .review-verified svg {
    width: 14px;
    height: 14px;
    fill: #2e7d32;
  }

  /* Controles del Carrusel (Flechas y Puntos) */
  .carousel-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .carousel-btn {
    background: #FFFFFF;
    border: 2px solid rgba(107, 74, 47, 0.2);
    width: 45px;
    height: 45px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: {{ section.settings.accent_color | default: '#6B4A2F' }};
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
  }

  .carousel-btn:hover {
    background: {{ section.settings.accent_color | default: '#6B4A2F' }};
    color: #FFFFFF;
    border-color: {{ section.settings.accent_color | default: '#6B4A2F' }};
  }

  .carousel-dots {
    display: flex;
    gap: 0.6rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(107, 74, 47, 0.2);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .dot.active {
    background: {{ section.settings.accent_color | default: '#6B4A2F' }};
    width: 24px;
    border-radius: 6px;
  }
{%- endstyle -%}

<div class="reviews-section-{{ section.id }} section-{{ section.id }}-padding">
  <div class="reviews-section-container">
    
    <!-- Cabecera con Título y Beneficios -->
    <div class="reviews-header">
      <div class="reviews-eyebrow">{{ section.settings.eyebrow_text | default: 'Lo que dicen nuestros clientes' }}</div>
      <h2 class="reviews-main-title">{{ section.settings.main_title | default: 'Todos los poderes, en cada taza' }}</h2>

      <!-- Cuadrícula de Beneficios / Poderes -->
      <div class="powers-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'power' -%}
            <div class="power-item" {{ block.shopify_attributes }}>
              <div class="power-icon">
                {%- if block.settings.icon_symbol != blank -%}
                  {{ block.settings.icon_symbol }}
                {%- else -%}
                  ✦
                {%- endif -%}
              </div>
              <p class="power-text">{{ block.settings.power_title }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Carrusel de Reseñas -->
    <div class="reviews-carousel-wrapper">
      <div class="reviews-track" id="reviewsTrack">
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="review-card" {{ block.shopify_attributes }}>
              <div>
                <div class="review-stars">★★★★★</div>
                <p class="review-quote">"{{ block.settings.quote }}"</p>
              </div>
              <div class="review-author-wrapper">
                {%- if block.settings.author_image != blank -%}
                  {{ block.settings.author_image | image_url: width: 150 | image_tag: class: 'review-avatar', loading: 'lazy' }}
                {%- else -%}
                  <img src="https://cdn.shopify.com/s/files/1/0658/5832/2592/files/placeholder-avatar.png" class="review-avatar" alt="Cliente" loading="lazy" width="50" height="50">
                {%- endif -%}
                <div>
                  <h4 class="review-author-name">{{ block.settings.author_name }}</h4>
                  <p class="review-verified">
                    <svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5L4 14.15 9 19.15 20 8.15 18.5 6.7z"/></svg>
                    Cliente verificado
                  </p>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Controles de navegación del carrusel -->
    <div class="carousel-controls">
      <button type="button" class="carousel-btn" id="prevReviewBtn" aria-label="Anterior">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="carousel-dots" id="carouselDots"></div>
      <button type="button" class="carousel-btn" id="nextReviewBtn" aria-label="Siguiente">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

  </div>
</div>

<!-- Script del carrusel dinámico -->
<script>
  (function() {
    function initReviewsCarousel() {
      const track = document.getElementById("reviewsTrack");
      const prevBtn = document.getElementById("prevReviewBtn");
      const nextBtn = document.getElementById("nextReviewBtn");
      const dotsContainer = document.getElementById("carouselDots");
      
      if (!track) return;
      const cards = track.querySelectorAll(".review-card");
      if (cards.length === 0) return;

      let currentIndex = 0;
      
      function getCardsPerView() {
        return window.innerWidth >= 750 ? 3 : 1;
      }

      let maxIndex = Math.max(0, cards.length - getCardsPerView());

      // Crear puntos indicadores
      dotsContainer.innerHTML = "";
      const totalDots = maxIndex + 1;
      for (let i = 0; i <= maxIndex; i++) {
        const dot = document.createElement("div");
        dot.classList.add("dot");
        if (i === 0) dot.classList.add("active");
        dot.addEventListener("click", () => {
          currentIndex = i;
          updateCarousel();
        });
        dotsContainer.appendChild(dot);
      }

      function updateCarousel() {
        const cardWidth = cards[0].getBoundingClientRect().width;
        const gap = 32; // 2rem gap
        const offset = -currentIndex * (cardWidth + (window.innerWidth >= 750 ? gap : 0));
        track.style.transform = `translateX(${offset}px)`;

        const dots = dotsContainer.querySelectorAll(".dot");
        dots.forEach((dot, idx) => {
          dot.classList.toggle("active", idx === currentIndex);
        });
      }

      nextBtn.addEventListener("click", () => {
        maxIndex = Math.max(0, cards.length - getCardsPerView());
        currentIndex = currentIndex < maxIndex ? currentIndex + 1 : 0;
        updateCarousel();
      });

      prevBtn.addEventListener("click", () => {
        maxIndex = Math.max(0, cards.length - getCardsPerView());
        currentIndex = currentIndex > 0 ? currentIndex - 1 : maxIndex;
        updateCarousel();
      });

      window.addEventListener("resize", () => {
        maxIndex = Math.max(0, cards.length - getCardsPerView());
        if (currentIndex > maxIndex) currentIndex = maxIndex;
        updateCarousel();
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initReviewsCarousel);
    } else {
      initReviewsCarousel();
    }
  })();
</script>

