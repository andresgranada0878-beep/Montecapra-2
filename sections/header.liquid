<header class="montecapra-header">

  <div class="montecapra-announcement">
    <div class="montecapra-announcement-left">
      <a class="montecapra-social-icon" href="{{ section.settings.instagram_url | default: '#' }}" aria-label="Instagram" title="Instagram" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" class="montecapra-icon-fill"/></svg>
      </a>
      <a class="montecapra-social-icon" href="{{ section.settings.whatsapp_url | default: 'https://wa.me/573235010624' }}" aria-label="WhatsApp" title="WhatsApp" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"/><path d="M9 8.5c.3-.5.6-.5.9-.4l1 .2c.2.1.3.3.4.6l.5 1.2c.1.2 0 .4-.1.6l-.5.6c-.2.2-.2.4 0 .6.5.8 1.2 1.4 2.1 1.8.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.7-.1l1.2.6c.3.1.4.3.4.5 0 .7-.4 1.3-.9 1.6-.6.4-1.4.5-2.2.2a9 9 0 0 1-3.5-2.1 8.5 8.5 0 0 1-2-2.8c-.4-1.1-.2-1.9.7-2.2Z"/></svg>
      </a>
      <a class="montecapra-social-icon" href="{{ section.settings.rappi_url | default: '#' }}" aria-label="Rappi" title="Rappi" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><text x="12" y="16" text-anchor="middle" class="montecapra-icon-letter">R</text></svg>
      </a>
    </div>

    <div class="montecapra-announcement-center">
      <span>Obt&#233;n 10% OFF en tu primera compra</span>
      <strong>C&#243;digo: {{ section.settings.discount_code | default: 'MONTE10' }}</strong>
    </div>

    <div class="montecapra-announcement-right"><span aria-label="Colombia">&#127464;&#127476;</span><span>COP</span></div>
  </div>



  <div class="montecapra-header-principal">


    <div class="montecapra-header-izquierda">

      <button class="montecapra-menu" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>


      <a href="{{ routes.search_url }}" class="montecapra-busqueda">
        Buscar
      </a>

    </div>



    <a href="{{ routes.root_url }}" class="montecapra-logo">

      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag }}
      {% else %}
        Montecapra
      {% endif %}

    </a>




    <div class="montecapra-header-derecha">

      <a href="{{ routes.account_url }}" class="montecapra-icono">
        Cuenta
      </a>


      <a href="{{ routes.cart_url }}" class="montecapra-icono">
        Bolsa
      </a>

    </div>


  </div>




  <nav class="montecapra-navegacion">

    {% for link in section.settings.menu.links %}

      <a href="{{ link.url }}">
        {{ link.title }}
      </a>

    {% endfor %}

  </nav>


</header>




{% stylesheet %}


.montecapra-header {
  width:100%;
  background:#FAF8F3;
}



.montecapra-announcement {
  width:calc(100% - 32px);
  max-width:1600px;
  height:52px;
  min-height:52px;
  margin:18px auto 0;
  padding:0 24px;
  border-radius:30px;
  background:#23160F;
  color:#FAF8F3;
  display:grid;
  grid-template-columns:1fr auto 1fr;
  align-items:center;
  gap:16px;
  font-size:12px;
  letter-spacing:.04em;
  box-sizing:border-box;
}

.montecapra-announcement a {
  color:#FAF8F3;
  text-decoration:none;
}

.montecapra-announcement-left {
  display:flex;
  align-items:center;
  gap:16px;
  white-space:nowrap;
}

.montecapra-announcement .montecapra-social-icon {
  display:inline-flex;
  width:18px;
  height:18px;
  align-items:center;
  justify-content:center;
}

.montecapra-social-icon svg {
  width:18px;
  height:18px;
  fill:none;
  stroke:currentColor;
  stroke-linecap:round;
  stroke-linejoin:round;
  stroke-width:1.6;
}

.montecapra-social-icon .montecapra-icon-fill {
  fill:currentColor;
  stroke:none;
}

.montecapra-social-icon .montecapra-icon-letter {
  fill:currentColor;
  stroke:none;
  font-family:Arial, sans-serif;
  font-size:12px;
  font-weight:700;
}

.montecapra-announcement-center {
  display:flex;
  align-items:center;
  justify-content:center;
  gap:12px;
  text-align:center;
  white-space:nowrap;
}

.montecapra-announcement-center strong {
  color:#C6A86B;
}

.montecapra-announcement-right {
  justify-self:end;
  display:flex;
  align-items:center;
  gap:6px;
  white-space:nowrap;
}

.montecapra-announcement-right > span:first-child::after {
  content:'Colombia |';
  margin-left:4px;
}





.montecapra-header-principal {

  max-width:1600px;

  margin:0 auto;

  padding:35px 40px;

  display:flex;

  align-items:center;

  justify-content:space-between;

}




.montecapra-header-izquierda,
.montecapra-header-derecha {

  display:flex;

  align-items:center;

  gap:24px;

}





.montecapra-menu {

  background:none;

  border:0;

  padding:0;

  cursor:pointer;

}



.montecapra-menu span {

  display:block;

  width:25px;

  height:1px;

  background:#23160F;

  margin:6px 0;

}




.montecapra-busqueda,
.montecapra-icono {

  color:#23160F;

  text-decoration:none;

  font-size:13px;

  letter-spacing:1px;

}




.montecapra-logo {

  display:flex;

  justify-content:center;

}



.montecapra-logo img {

  max-width:220px;

  height:auto;

}




.montecapra-navegacion {

  border-top:1px solid rgba(35,22,15,.12);

  border-bottom:1px solid rgba(35,22,15,.12);

  display:flex;

  justify-content:center;

  gap:45px;

  padding:22px;

}




.montecapra-navegacion a {

  color:#23160F;

  text-decoration:none;

  text-transform:uppercase;

  letter-spacing:2px;

  font-size:12px;

}




@media(max-width:749px){


.montecapra-announcement {
  width:calc(100% - 24px);
  height:52px;
  min-height:52px;
  margin:12px auto 0;
  padding:0 8px;
  grid-template-columns:auto minmax(0, 1fr) auto;
  gap:6px;
  font-size:9px;
}



.montecapra-announcement-left {
  gap:8px;
}

.montecapra-announcement-center {
  flex-wrap:wrap;
  gap:4px;
  min-width:0;
  line-height:1.15;
  white-space:normal;
}

.montecapra-announcement-center strong {
  white-space:nowrap;
}

.montecapra-announcement-right {
  gap:3px;
}


.montecapra-header-principal {

  padding:25px 20px;

}



.montecapra-busqueda {

  display:none;

}



.montecapra-logo img {

  max-width:160px;

}



.montecapra-navegacion {

  gap:18px;

  overflow:auto;

  justify-content:flex-start;

}



}



{% endstylesheet %}




{% schema %}
{
  "name": "Header Montecapra",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto promoción",
      "default": "Obtén 10% OFF en tu primera compra"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Código descuento",
      "default": "MONTE10"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp"
    },
    {
      "type": "url",
      "id": "rappi_url",
      "label": "Rappi"
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Mostrar moneda",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú navegación"
    }
  ],
  "presets": [
    {
      "name": "Header Montecapra"
    }
  ]
}
{% endschema %}