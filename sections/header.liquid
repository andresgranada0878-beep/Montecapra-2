<style>
  /* --- HEADER MONTECAPRA LIMPIO Y LETRAS GRANDES --- */
  .montecapra-header {
    width: 100%;
    background: #FAF8F3;
  }

  .montecapra-header-principal {
    max-width: 1600px;
    margin: 0 auto;
    padding: 12px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .montecapra-header-izquierda,
  .montecapra-header-derecha {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .montecapra-menu {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .montecapra-menu span {
    display: block;
    width: 25px;
    height: 1px;
    background: #23160F;
    margin: 6px 0;
  }

  .montecapra-busqueda,
  .montecapra-icono {
    color: #23160F;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 1px;
  }

  .montecapra-logo {
    display: flex;
    justify-content: center;
  }

  .montecapra-logo img {
    max-width: 180px;
    height: auto;
  }

  /* --- NAVEGACIÓN CON LETRA MÁS GRANDE Y ELEGANTE --- */
  .montecapra-navegacion {
    border-top: 1px solid rgba(35,22,15,.12);
    border-bottom: 1px solid rgba(35,22,15,.12);
    display: flex;
    justify-content: center;
    gap: 45px;
    padding: 18px 16px;
  }

  .montecapra-navegacion a {
    color: #23160F;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 15px; /* Aumentado para mayor protagonismo */
    font-weight: 750; /* Más cuerpo y presencia */
    transition: color 0.3s ease;
  }

  .montecapra-navegacion a:hover {
    color: #C6A86B; /* Tono dorado elegante al pasar el cursor */
  }

  @media(max-width: 749px) {
    .montecapra-header-principal {
      position: relative;
      padding: 15px 20px;
      justify-content: space-between;
    }

    .montecapra-header-derecha {
      gap: 8px;
      flex: 0 0 auto;
    }

    .montecapra-icono {
      font-size: 11px;
      letter-spacing: 0;
    }

    .montecapra-logo {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%,-50%);
    }

    .montecapra-busqueda {
      display: none;
    }

    .montecapra-logo img {
      max-width: min(140px, calc(100vw - 220px));
    }

    .montecapra-navegacion {
      width: 100%;
      box-sizing: border-box;
      gap: 20px;
      overflow-x: auto;
      justify-content: safe center;
      padding: 14px 10px;
    }

    .montecapra-navegacion a {
      font-size: 13px; /* Tamaño adaptado y legible en celulares */
    }
  }
</style>

<header class="montecapra-header">
  <div class="montecapra-header-principal">
    <div class="montecapra-header-izquierda">
      <button class="montecapra-menu" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <a href="{{ routes.search_url }}" class="montecapra-busqueda">Buscar</a>
    </div>

    <a href="{{ routes.root_url }}" class="montecapra-logo">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 400 | image_tag }}
      {% else %}
        Montecapra
      {% endif %}
    </a>

    <div class="montecapra-header-derecha">
      <a href="{{ routes.account_url }}" class="montecapra-icono">Cuenta</a>
      <a href="{{ routes.cart_url }}" class="montecapra-icono">Bolsa</a>
    </div>
  </div>

  <nav class="montecapra-navegacion">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
  </nav>
</header>

{% schema %}
{
  "name": "Header Montecapra",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú navegación"
    }
  ],
  "presets": [
    {
      "name": "Header Montecapra"
    }
  ]
}
{% endschema %}