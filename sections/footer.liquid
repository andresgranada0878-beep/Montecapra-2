{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: transparent !important;
    padding-top: {{ section.settings.padding_top | default: 20 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 20 }}px;
  }

  .montecapra-nl {
    width: 100%;
    max-width: 1300px; /* Respeta exactamente el ancho máximo de tus demás secciones */
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .montecapra-nl__wrapper {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    background-color: {{ section.settings.background_color | default: '#784F02' }};
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(35, 22, 15, 0.08);
  }

  @media screen and (min-width: 990px) {
    .montecapra-nl__wrapper {
      grid-template-columns: 45% 55%;
      align-items: stretch;
    }
  }

  /* COLUMNA IZQUIERDA: IMAGEN */
  .montecapra-nl__image-col {
    position: relative;
    width: 100%;
    height: 320px;
    background: #E5DED4;
    overflow: hidden;
  }

  @media screen and (min-width: 990px) {
    .montecapra-nl__image-col {
      height: 100%;
      min-height: 420px;
    }
  }

  .montecapra-nl__image-col img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  /* COLUMNA DERECHA: CONTENIDO Y FORMULARIO */
  .montecapra-nl__content-col {
    padding: 40px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media screen and (min-width: 990px) {
    .montecapra-nl__content-col {
      padding: 45px 55px;
    }
  }

  .montecapra-nl__eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: {{ section.settings.accent_color | default: '#C4915C' }};
    margin-bottom: 6px;
  }

  .montecapra-nl__title {
    font-family: inherit;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 10px 0;
  }

  .montecapra-nl__title em, .montecapra-nl__title i {
    font-style: italic;
    color: {{ section.settings.accent_color | default: '#C4915C' }};
  }

  .montecapra-nl__text {
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 20px 0;
    max-width: 550px;
  }

  /* FORMULARIO DE SUSCRIPCIÓN */
  .montecapra-nl__form-wrapper {
    margin-bottom: 28px;
    max-width: 580px;
  }

  .montecapra-nl__form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  @media screen and (min-width: 750px) {
    .montecapra-nl__form {
      flex-direction: row;
      background: #FFFFFF;
      border-radius: 999px;
      padding: 4px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }
  }

  .montecapra-nl__input-group {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0 16px;
  }

  .montecapra-nl__input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-size: 13.5px;
    color: #1E2D22;
    padding: 10px 0;
  }

  @media screen and (max-width: 749px) {
    .montecapra-nl__input {
      background: #FFFFFF;
      border-radius: 999px;
      padding: 12px 18px;
    }
  }

  .montecapra-nl__input::placeholder {
    color: #9A958E;
  }

  .montecapra-nl__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: {{ section.settings.button_color | default: '#A87845' }};
    color: #FFFFFF;
    border: none;
    border-radius: 999px;
    padding: 11px 22px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.25s ease, transform 0.25s ease;
    white-space: nowrap;
  }

  .montecapra-nl__submit:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .montecapra-nl__message {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 500;
  }

  .montecapra-nl__message--success {
    color: #85D4A0;
  }

  /* BENEFICIOS / ICONOS INFERIORES */
  .montecapra-nl__benefits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 20px;
  }

  @media screen and (min-width: 750px) {
    .montecapra-nl__benefits {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }

  .montecapra-nl__benefit-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .montecapra-nl__benefit-icon {
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .montecapra-nl__benefit-text {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.9);
  }
{%- endstyle -%}

<div class="montecapra-nl">
  <div class="montecapra-nl__wrapper">
    
    <!-- COLUMNA IZQUIERDA: IMAGEN -->
    <div class="montecapra-nl__image-col">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
      {%- else -%}
        <img src="https://cdn.shopify.com/s/files/1/0658/5832/2592/files/hero-origen-montecapra.jpg" alt="Café MonteCapra" loading="lazy" width="1400" height="900">
      {%- endif -%}
    </div>

    <!-- COLUMNA DERECHA: TEXTO, FORMULARIO E ICONOS -->
    <div class="montecapra-nl__content-col">
      {%- if section.settings.eyebrow != blank -%}
        <div class="montecapra-nl__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="montecapra-nl__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="montecapra-nl__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <!-- FORMULARIO -->
      <div class="montecapra-nl__form-wrapper">
        {%- form 'customer', id: 'MontecapraNewsletterForm', class: 'montecapra-nl__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="montecapra-nl__input-group">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterForm-{{ section.id }}"
              class="montecapra-nl__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.placeholder_text | default: 'Tu correo electrónico' }}"
              required
            >
          </div>
          <button type="submit" class="montecapra-nl__submit" name="commit">
            {{ section.settings.button_text | default: 'Suscribirme' }} <span>→</span>
          </button>
        {%- endform -%}

        {%- if form.posted_successfully? -%}
          <div class="montecapra-nl__message montecapra-nl__message--success" tabindex="-1" autofocus>
            ¡Gracias por suscribirte!
          </div>
        {%- elsif form.errors -%}
          <div class="montecapra-nl__message" style="color: #FFB4AB;">
            {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
          </div>
        {%- endif -%}
      </div>

      <!-- ICONOS / BENEFICIOS INFERIORES -->
      {%- if section.blocks.size > 0 -%}
        <div class="montecapra-nl__benefits">
          {%- for block in section.blocks -%}
            <div class="montecapra-nl__benefit-item" {{ block.shopify_attributes }}>
              <div class="montecapra-nl__benefit-icon">
                {%- case block.settings.icon_type -%}
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path></svg>
                  {%- when 'tag' -%}
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                  {%- when 'book' -%}
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                  {%- when 'coffee' -%}
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
                {%- endcase -%}
              </div>
              <span class="montecapra-nl__benefit-text">{{ block.settings.title }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Newsletter MonteCapra",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen izquierda"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo imagen",
      "default": "Café MonteCapra"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NEWSLETTER"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Café, historias y novedades <em>directo a tu correo</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Descripción",
      "default": "Suscríbete y sé el primero en conocer lanzamientos, experiencias, contenidos exclusivos y más sobre el mundo del café MonteCapra."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Texto placeholder input",
      "default": "Tu correo electrónico"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto botón",
      "default": "Suscribirme"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo tarjeta",
      "default": "#784F02"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto principal",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color acento (ej. dorado)",
      "default": "#C4915C"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Color del botón",
      "default": "#A87845"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding superior",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding inferior",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio / Icono",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Tipo de icono",
          "options": [
            { "value": "gift", "label": "Regalo (Lanzamientos)" },
            { "value": "tag", "label": "Etiqueta (Promociones)" },
            { "value": "book", "label": "Libro (Historias)" },
            { "value": "coffee", "label": "Taza (Consejos)" }
          ],
          "default": "gift"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Texto del beneficio",
          "default": "Lanzamientos exclusivos"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Newsletter MonteCapra",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon_type": "gift",
            "title": "Lanzamientos exclusivos"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_type": "tag",
            "title": "Promociones especiales"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_type": "book",
            "title": "Historias y contenido de café"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_type": "coffee",
            "title": "Consejos y experiencias"
          }
        }
      ]
    }
  ]
}
{% endschema %}