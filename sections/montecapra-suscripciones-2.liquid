{% liquid
  assign section_bg = section.settings.section_background | default: '#F7F4EF'
  assign text_color = section.settings.text_color | default: '#23160F'
  assign accent_color = section.settings.accent_color | default: '#6B4A2F'
  assign button_color = section.settings.button_color | default: '#23160F'
%}

<section
  id="MontecapraSubscriptions-{{ section.id }}"
  class="montecapra-sub-section"
  style="--sub-bg: {{ section_bg }}; --sub-text: {{ text_color }}; --sub-accent: {{ accent_color }}; --sub-btn: {{ button_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="montecapra-sub__container">
    
    <!-- ENCABEZADO IDÉNTICO AL DE PRODUCTOS -->
    <header class="montecapra-sub__header">
      <h2 class="montecapra-sub__heading">Suscríbete</h2>
      {% if section.settings.subtitle != blank %}
        <p class="montecapra-sub__subheading">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </header>

    <div class="montecapra-sub__grid">
      <!-- COLUMNA IZQUIERDA: IMAGEN PREMIUM -->
      <div class="montecapra-sub__media-wrapper">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1200, 1400',
              sizes: '(min-width: 990px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image.alt | default: 'Suscripción de café Montecapra',
              class: 'montecapra-sub__image'
          }}
        {% else %}
          <div class="montecapra-sub__image-placeholder">
            <span>Sube la imagen principal de la caja</span>
          </div>
        {% endif %}
        <div class="montecapra-sub__badge-float">
          <span>☕ Envío Gratis Incluido</span>
        </div>
      </div>

      <!-- COLUMNA DERECHA: CONFIGURADOR -->
      <div class="montecapra-sub__configurator">
        <div class="montecapra-sub__intro-text">
          {% if section.settings.title != blank %}
            <h3>{{ section.settings.title | escape }}</h3>
          {% endif %}
        </div>

        <!-- PASO 1: PLANES -->
        <div class="montecapra-sub__step">
          <div class="montecapra-sub__step-title">
            <span class="montecapra-sub__step-number">1</span>
            <span>Elige tu plan ideal</span>
          </div>
          <div class="montecapra-sub__plans-grid" role="radiogroup">
            {% for block in section.blocks %}
              {% if block.type == 'plan' %}
                <label class="montecapra-sub__plan-card {% if forloop.first %}is-selected{% endif %}" {{ block.shopify_attributes }}>
                  <input type="radio" name="subscription_plan_{{ section.id }}" value="{{ block.settings.title | escape }}" {% if forloop.first %}checked{% endif %} class="visually-hidden">
                  <div class="montecapra-sub__plan-info">
                    <span class="montecapra-sub__plan-name">{{ block.settings.title | escape }}</span>
                    {% if block.settings.capsules_text != blank %}
                      <span class="montecapra-sub__plan-caps">{{ block.settings.capsules_text | escape }}</span>
                    {% endif %}
                  </div>
                  <div class="montecapra-sub__plan-price">
                    <span class="montecapra-sub__price-amount">{{ block.settings.price | escape }}</span>
                  </div>
                </label>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <!-- PASO 2: VARIEDADES -->
        <div class="montecapra-sub__step">
          <div class="montecapra-sub__step-header-row">
            <div class="montecapra-sub__step-title">
              <span class="montecapra-sub__step-number">2</span>
              <span>Personaliza tus variedades</span>
            </div>
            <span class="montecapra-sub__counter-pill" id="totalCycleCount-{{ section.id }}">Total ciclo: 10 cápsulas</span>
          </div>

          <div class="montecapra-sub__varieties-list">
            {% for block in section.blocks %}
              {% if block.type == 'variety' %}
                <div class="montecapra-sub__variety-item" {{ block.shopify_attributes }}>
                  <div class="montecapra-sub__variety-meta">
                    {% if block.settings.image != blank %}
                      <img src="{{ block.settings.image | image_url: width: 120 }}" alt="{{ block.settings.title | escape }}" class="montecapra-sub__variety-thumb" loading="lazy">
                    {% endif %}
                    <div>
                      <h4 class="montecapra-sub__variety-name">{{ block.settings.title | escape }}</h4>
                      {% if block.settings.description != blank %}
                        <p class="montecapra-sub__variety-desc">{{ block.settings.description | escape }}</p>
                      {% endif %}
                    </div>
                  </div>
                  <div class="montecapra-sub__qty-selector" data-qty-container>
                    <button type="button" class="montecapra-sub__qty-btn" data-qty-dec aria-label="Disminuir">-</button>
                    <span class="montecapra-sub__qty-value" data-qty-display>0</span>
                    <button type="button" class="montecapra-sub__qty-btn" data-qty-inc aria-label="Aumentar">+</button>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <!-- CTA -->
        <div class="montecapra-sub__cta-wrapper">
          <button type="button" class="montecapra-sub__submit-btn">
            Activar mi suscripción con descuento <span>→</span>
          </button>
          <p class="montecapra-sub__secure-note">🔒 Cancela o pausa cuando quieras sin penalizaciones.</p>
        </div>

      </div>
    </div>
  </div>
</section>

{% style %}
  #MontecapraSubscriptions-{{ section.id }} {
    background-color: var(--sub-bg);
    color: var(--sub-text);
    font-family: inherit;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__container {
    max-width: 1750px;
    margin: 0 auto;
    padding: 0 24px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__header {
    margin-bottom: 36px;
    text-align: center;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__heading {
    margin: 0 0 8px 0;
    color: inherit;
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__subheading {
    margin: 0 auto;
    max-width: 600px;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.8;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }
  @media screen and (min-width: 1024px) {
    #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
      align-items: center;
    }
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__media-wrapper {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 12px 35px rgba(35, 22, 15, 0.06);
    aspect-ratio: 4 / 5;
    background: #e8e1d7;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__badge-float {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background: #ffffff;
    color: #23160F;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__configurator {
    background: #ffffff;
    padding: 36px 32px;
    border-radius: 28px;
    box-shadow: 0 12px 35px rgba(35, 22, 15, 0.06);
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__intro-text h3 {
    margin: 0 0 24px 0;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.35;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__step {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(35, 22, 15, 0.08);
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__step:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__step-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 14px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--sub-accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__step-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__counter-pill {
    font-size: 11px;
    font-weight: 600;
    background: rgba(107, 74, 47, 0.1);
    color: var(--sub-accent);
    padding: 4px 10px;
    border-radius: 999px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__plans-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__plan-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 14px 10px;
    border: 2px solid rgba(35, 22, 15, 0.12);
    border-radius: 14px;
    background: #faf8f3;
    cursor: pointer;
    text-align: center;
    transition: all 0.25s ease;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__plan-card.is-selected {
    border-color: var(--sub-accent);
    background: #ffffff;
    box-shadow: 0 4px 15px rgba(107, 74, 47, 0.15);
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__plan-name {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__plan-caps {
    display: block;
    font-size: 10px;
    opacity: 0.7;
    margin-bottom: 8px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__price-amount {
    font-size: 14px;
    font-weight: 800;
    color: var(--sub-accent);
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__varieties-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__variety-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    border: 1px solid rgba(35, 22, 15, 0.1);
    border-radius: 12px;
    background: #fdfcf9;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__variety-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__variety-thumb {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__variety-name {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__variety-desc {
    margin: 2px 0 0;
    font-size: 10.5px;
    opacity: 0.7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 160px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__qty-selector {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #f0ece3;
    padding: 4px 8px;
    border-radius: 999px;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__qty-btn {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: #ffffff;
    color: #23160F;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__qty-btn:hover {
    background: var(--sub-accent);
    color: #fff;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__qty-value {
    min-width: 18px;
    text-align: center;
    font-size: 12px;
    font-weight: 700;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__cta-wrapper {
    margin-top: 20px;
    text-align: center;
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 48px;
    padding: 12px 20px;
    border: none;
    border-radius: 999px;
    background: var(--sub-btn);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 6px 16px rgba(35, 22, 15, 0.15);
  }
  #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__secure-note {
    margin: 10px 0 0 0;
    font-size: 11.5px;
    opacity: 0.7;
  }
  @media screen and (max-width: 749px) {
    #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__plans-grid {
      grid-template-columns: 1fr;
    }
    #MontecapraSubscriptions-{{ section.id }} .montecapra-sub__configurator {
      padding: 24px 20px;
    }
  }
{% endstyle %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('MontecapraSubscriptions-{{ section.id }}');
    if (!section) return;

    const planCards = section.querySelectorAll('.montecapra-sub__plan-card');
    planCards.forEach(card => {
      card.addEventListener('click', () => {
        planCards.forEach(c => c.classList.remove('is-selected'));
        card.classList.add('is-selected');
        const radio = card.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
      });
    });

    const varietyItems = section.querySelectorAll('.montecapra-sub__variety-item');
    const counterPill = section.querySelector('#totalCycleCount-{{ section.id }}');

    varietyItems.forEach(item => {
      const decBtn = item.querySelector('[data-qty-dec]');
      const incBtn = item.querySelector('[data-qty-inc]');
      const display = item.querySelector('[data-qty-display]');
      let currentVal = parseInt(display.textContent) || 0;

      decBtn.addEventListener('click', () => {
        if (currentVal > 0) {
          currentVal--;
          display.textContent = currentVal;
          updateTotal();
        }
      });
      incBtn.addEventListener('click', () => {
        currentVal++;
        display.textContent = currentVal;
        updateTotal();
      });
    });

    function updateTotal() {
      let total = 0;
      section.querySelectorAll('[data-qty-display]').forEach(d => {
        total += parseInt(d.textContent) || 0;
      });
      if (counterPill) {
        counterPill.textContent = `Total ciclo: ${total} cápsulas`;
      }
    }
  });
</script>

{% schema %}
{
  "name": "Suscripciones café 2",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen principal de la caja"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título del bloque configurador",
      "default": "Disfruta tu café favorito sin preocupaciones cada mes"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtítulo de sección",
      "default": "Elige tu plan ideal, personaliza tus cápsulas de 10 en 10 y recibe frescura garantizada con beneficios exclusivos."
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Fondo de sección",
      "default": "#F7F4EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#23160F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento",
      "default": "#6B4A2F"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Color de botón",
      "default": "#23160F"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacio inferior",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan de suscripción",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Nombre del plan",
          "default": "1 mes"
        },
        {
          "type": "text",
          "id": "capsules_text",
          "label": "Detalle de cápsulas",
          "default": "10 cápsulas"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Precio",
          "default": "$29.000"
        }
      ]
    },
    {
      "type": "variety",
      "name": "Variedad de café",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de variedad"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre de variedad",
          "default": "Reserva"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción corta",
          "default": "Espresso intenso. Notas a cacao y frutos secos."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Suscripciones café 2 Pro"
    }
  ]
}
{% endschema %}