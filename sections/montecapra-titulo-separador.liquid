<section
  id="MontecapraTitulo-{{ section.id }}"
  class="montecapra-section-title-wrapper"
  style="background-color: {{ section.settings.background_color | default: '#F7F4EF' }}; color: {{ section.settings.text_color | default: '#23160F' }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="montecapra-title-container">
    {%- if section.settings.eyebrow != blank -%}
      <span class="montecapra-title-eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    
    <h2 class="montecapra-main-heading">{{ section.settings.heading | escape }}</h2>
    
    {%- if section.settings.subtitle != blank -%}
      <p class="montecapra-title-subheading">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% style %}
  #MontecapraTitulo-{{ section.id }} {
    width: 100%;
    display: block;
  }

  .montecapra-title-container {
    max-width: 1750px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: {{ section.settings.text_alignment }};
  }

  .montecapra-title-eyebrow {
    display: inline-block;
    padding: 6px 14px;
    margin-bottom: 10px;
    border-radius: 999px;
    background: rgba(107, 74, 47, 0.1);
    color: {{ section.settings.accent_color | default: '#6B4A2F' }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .montecapra-main-heading {
    margin: 0 0 8px 0;
    color: inherit;
    font-size: clamp(32px, 4vw, 50px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .montecapra-title-subheading {
    margin: {% if section.settings.text_alignment == 'center' %}0 auto{% else %}0{% endif %};
    max-width: 650px;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.8;
  }
{% endstyle %}

{% schema %}
{
  "name": "Título de Sección Pro",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior pequeña (opcional)"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título Principal",
      "default": "Suscríbete"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtítulo (opcional)",
      "default": "Elige tu plan ideal y recibe frescura garantizada cada mes."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fondo de sección",
      "default": "#F7F4EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#23160F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de acento",
      "default": "#6B4A2F"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio inferior",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Título de Sección Pro"
    }
  ]
}
{% endschema %}