<div class="montecapra-top-bar">
  <div class="montecapra-top-content">
    
    <!-- Lado Izquierdo: Redes Sociales -->
    <div class="montecapra-top-left">
      <a href="{{ section.settings.instagram_url | default: '#' }}" class="montecapra-top-icon" aria-label="Instagram" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
      </a>
      <a href="{{ section.settings.whatsapp_url | default: '#' }}" class="montecapra-top-icon" aria-label="WhatsApp" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"/><path d="M9 8.5c.3-.5.6-.5.9-.4l1 .2c.2.1.3.3.4.6l.5 1.2c.1.2 0 .4-.1.6l-.5.6c-.2.2-.2.4 0 .6.5.8 1.2 1.4 2.1 1.8.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.7-.1l1.2.6c.3.1.4.3.4.5 0 .7-.4 1.3-.9 1.6-.6.4-1.4.5-2.2.2a9 9 0 0 1-3.5-2.1 8.5 8.5 0 0 1-2-2.8c-.4-1.1-.2-1.9.7-2.2Z"/></svg>
      </a>
      <a href="{{ section.settings.rappi_url | default: '#' }}" class="montecapra-top-icon" aria-label="Rappi" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><text x="12" y="16" text-anchor="middle" fill="currentColor" font-size="12" font-weight="700">R</text></svg>
      </a>
    </div>

    <!-- Centro: Texto Promocional -->
    <div class="montecapra-top-center">
      <span>{{ section.settings.announcement_text }}</span>
      {%- if section.settings.discount_code != blank -%}
        <strong>{{ section.settings.discount_code }}</strong>
      {%- endif -%}
    </div>

    <!-- Lado Derecho: Ubicación / Moneda -->
    <div class="montecapra-top-right">
      <span>🇨🇴 Colombia |</span>
      <span>COP</span>
    </div>

  </div>
</div>

<style>
  .montecapra-top-bar {
    width: 100%;
    background-color: {{ section.settings.bg_color }};
    padding: 8px 0;
  }
  .montecapra-top-content {
    width: calc(100% - 32px);
    max-width: 1600px;
    height: 66px; /* 50% más ancha (de 44px a 66px) */
    margin: 0 auto;
    padding: 0 30px;
    border-radius: {{ section.settings.border_radius }}px;
    background-color: {{ section.settings.box_bg }};
    color: {{ section.settings.text_color }};
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    font-size: 13px;
    letter-spacing: .04em;
    box-sizing: border-box;
  }
  .montecapra-top-content a {
    color: {{ section.settings.text_color }};
    text-decoration: none;
  }
  .montecapra-top-left {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .montecapra-top-icon {
    display: inline-flex;
    width: 22px; /* Iconos proporcionalmente más grandes */
    height: 22px;
    align-items: center;
    justify-content: center;
  }
  .montecapra-top-icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
  .montecapra-top-center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    white-space: nowrap;
    text-transform: uppercase;
    font-weight: 700;
  }
  .montecapra-top-center strong {
    color: {{ section.settings.accent_color }};
  }
  .montecapra-top-right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-weight: 600;
  }
  @media(max-width: 749px) {
    .montecapra-top-content {
      width: calc(100% - 16px);
      height: 52px;
      padding: 0 12px;
      font-size: 10px;
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .montecapra-top-center {
      flex-wrap: wrap;
      gap: 2px;
      white-space: normal;
      line-height: 1.1;
    }
  }
</style>

{% schema %}
{
  "name": "Barra Superior Montecapra",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Texto de promoción",
      "default": "ENVÍO GRATIS por compras superiores a"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Código / Valor destacado",
      "default": "$150.000"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Enlace Instagram"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "Enlace WhatsApp"
    },
    {
      "type": "url",
      "id": "rappi_url",
      "label": "Enlace Rappi"
    },
    {
      "type": "header",
      "content": "Estilos y Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo exterior",
      "default": "#FAF8F3"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Color de la barra (Cápsula)",
      "default": "#1A211E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#F1E68D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color destacado",
      "default": "#F1E68D"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Redondeo de esquinas",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Barra Superior Montecapra"
    }
  ]
}
{% endschema %}