{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.background_color | default: '#F7F4EF' }};
    color: {{ section.settings.text_color | default: '#23160F' }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .maquila-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero Principal */
  .maquila-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 5rem;
  }

  @media screen and (min-width: 990px) {
    .maquila-hero {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }

  .maquila-hero-image {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0,0,0,0.06);
  }

  .maquila-hero-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .maquila-eyebrow {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    opacity: 0.65;
    margin-bottom: 0.8rem;
  }

  .maquila-title {
    font-size: 2.6rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 1.2rem 0;
  }

  @media screen and (min-width: 750px) {
    .maquila-title {
      font-size: 3.5rem;
    }
  }

  .maquila-desc {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 2.5rem;
  }

  .maquila-features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  @media screen and (min-width: 750px) {
    .maquila-features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .maquila-feature-item {
    text-align: center;
    background: rgba(255, 255, 255, 0.5);
    padding: 1.2rem 0.8rem;
    border-radius: 12px;
    border: 1px solid rgba(107, 74, 47, 0.08);
  }

  .maquila-feature-icon {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .maquila-feature-title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  .maquila-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    background-color: {{ section.settings.button_color | default: '#23160F' }};
    color: #FFFFFF;
    padding: 1.2rem 2.2rem;
    border-radius: 12px;
    font-size: 1.2rem;
    font-weight: 800;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    box-shadow: 0 8px 20px rgba(35, 22, 15, 0.2);
  }

  .maquila-btn:hover {
    opacity: 0.92;
    transform: translateY(-2px);
  }

  /* Sección Cómo Funciona (Pasos) */
  .steps-section {
    margin-bottom: 5rem;
    text-align: center;
  }

  .steps-subtitle {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 700;
    opacity: 0.65;
    margin-bottom: 0.6rem;
  }

  .steps-main-title {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 3.5rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 750px) {
    .steps-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .step-card {
    background: #FFFFFF;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    text-align: left;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0,0,0,0.04);
    position: relative;
  }

  .step-image-wrap {
    position: relative;
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: #eae3db;
  }

  .step-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .step-number-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    width: 36px;
    height: 36px;
    background: {{ section.settings.accent_color | default: '#6B4A2F' }};
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 1.1rem;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    z-index: 2;
  }

  .step-content {
    padding: 1.8rem 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .step-title {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.8rem 0;
  }

  .step-desc {
    font-size: 1.05rem;
    line-height: 1.5;
    opacity: 0.75;
    margin: 0;
  }

  /* Barra de Beneficios Inferior */
  .bottom-badges-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
    background: rgba(255, 255, 255, 0.7);
    padding: 2rem;
    border-radius: 20px;
    border: 1px solid rgba(107, 74, 47, 0.08);
    margin-bottom: 5rem;
  }

  @media screen and (min-width: 990px) {
    .bottom-badges-bar {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .bottom-badge-item {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .bottom-badge-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .bottom-badge-text {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
  }

  /* Banner Final Cta Dinámico */
  .maquila-cta-banner {
    background-color: {{ section.settings.cta_bg_color | default: '#23160F' }};
    color: {{ section.settings.cta_text_color | default: '#FFFFFF' }};
    border-radius: 24px;
    padding: 3.5rem 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  @media screen and (min-width: 990px) {
    .maquila-cta-banner {
      grid-template-columns: 1.2fr 1fr;
      padding: 4.5rem;
    }
  }

  .maquila-cta-title {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 1rem 0;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .maquila-cta-title {
      font-size: 3.2rem;
    }
  }

  .maquila-cta-desc {
    font-size: 1.2rem;
    line-height: 1.6;
    opacity: 0.85;
    margin: 0;
    color: inherit;
  }

  .maquila-cta-image {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 15px 30px rgba(0,0,0,0.3);
  }

  .maquila-cta-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
{%- endstyle -%}

<div class="maquila-section-{{ section.id }} section-{{ section.id }}-padding">
  <div class="maquila-container">
    
    <!-- Hero Principal -->
    <div class="maquila-hero">
      <div class="maquila-hero-image">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'Maquila de Café Montecapra' }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0658/5832/2592/files/maquila-hero.jpg" alt="Maquila de Café" loading="lazy" width="1200" height="800">
        {%- endif -%}
      </div>
      <div>
        <div class="maquila-eyebrow">{{ section.settings.hero_eyebrow }}</div>
        <h1 class="maquila-title">{{ section.settings.hero_title }}</h1>
        <p class="maquila-desc">{{ section.settings.hero_desc }}</p>

        <!-- Iconos Grid del Hero -->
        <div class="maquila-features-grid">
          <div class="maquila-feature-item">
            <div class="maquila-feature-icon">🌿</div>
            <p class="maquila-feature-title">Café colombiano de origen</p>
          </div>
          <div class="maquila-feature-item">
            <div class="maquila-feature-icon">♻️</div>
            <p class="maquila-feature-title">Cápsulas de aluminio reciclables</p>
          </div>
          <div class="maquila-feature-item">
            <div class="maquila-feature-icon">⚙️</div>
            <p class="maquila-feature-title">Producción especializada</p>
          </div>
          <div class="maquila-feature-item">
            <div class="maquila-feature-icon">⭐</div>
            <p class="maquila-feature-title">Acompañamiento integral</p>
          </div>
        </div>

        <a href="{{ section.settings.btn_url | default: '#contacto' }}" class="maquila-btn">
          {{ section.settings.btn_text }} →
        </a>
      </div>
    </div>

    <!-- Sección Cómo Funciona (Pasos dinámicos) -->
    <div class="steps-section">
      <div class="steps-subtitle">{{ section.settings.steps_eyebrow }}</div>
      <h2 class="steps-main-title">{{ section.settings.steps_title }}</h2>

      <div class="steps-grid">
        {%- assign step_counter = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_counter = step_counter | plus: 1 -%}
            <div class="step-card" {{ block.shopify_attributes }}>
              <div class="step-image-wrap">
                <div class="step-number-badge">{{ step_counter }}</div>
                {%- if block.settings.step_image != blank -%}
                  {{ block.settings.step_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                {%- else -%}
                  <img src="https://cdn.shopify.com/s/files/1/0658/5832/2592/files/step-{{ step_counter }}.jpg" alt="Paso {{ step_counter }}" loading="lazy" width="600" height="450">
                {%- endif -%}
              </div>
              <div class="step-content">
                <h3 class="step-title">{{ block.settings.step_title }}</h3>
                <p class="step-desc">{{ block.settings.step_desc }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <!-- Barra de Badges / Garantías Inferior -->
    <div class="bottom-badges-bar">
      <div class="bottom-badge-item">
        <div class="bottom-badge-icon">🌿</div>
        <p class="bottom-badge-text">Café colombiano de origen</p>
      </div>
      <div class="bottom-badge-item">
        <div class="bottom-badge-icon">♻️</div>
        <p class="bottom-badge-text">Cápsulas de aluminio reciclables</p>
      </div>
      <div class="bottom-badge-item">
        <div class="bottom-badge-icon">⚙️</div>
        <p class="bottom-badge-text">Más de 50 cafés encapsulados</p>
      </div>
      <div class="bottom-badge-item">
        <div class="bottom-badge-icon">🛡️</div>
        <p class="bottom-badge-text">Garantía de compatibilidad Nespresso® Original</p>
      </div>
      <div class="bottom-badge-item">
        <div class="bottom-badge-icon">⭐</div>
        <p class="bottom-badge-text">Experiencia desde el 2020</p>
      </div>
    </div>

    <!-- Banner Final CTA Personalizable -->
    <div class="maquila-cta-banner" {{ section.shopify_attributes }}>
      <div>
        <div style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.15em; font-weight: 700; opacity: 0.7; margin-bottom: 0.5rem;">{{ section.settings.cta_eyebrow }}</div>
        <h2 class="maquila-cta-title">{{ section.settings.cta_title }}</h2>
        <p class="maquila-cta-desc">{{ section.settings.cta_desc }}</p>
        <div style="margin-top: 2rem;">
          <a href="{{ section.settings.cta_btn_url | default: '#contacto' }}" class="maquila-btn" style="background-color: {{ section.settings.cta_btn_bg | default: '#FFFFFF' }}; color: {{ section.settings.cta_btn_text_color | default: '#23160F' }};">
            {{ section.settings.cta_btn_text }} →
          </a>
        </div>
      </div>
      <div class="maquila-cta-image">
        {%- if section.settings.cta_image != blank -%}
          {{ section.settings.cta_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: 'Proyecto Maquila' }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0658/5832/2592/files/maquila-cta.jpg" alt="Proyecto Maquila" loading="lazy" width="800" height="600">
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% schema %}
