{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .sub-builder-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  @media screen and (min-width: 990px) {
    .sub-builder-container {
      grid-template-columns: 1.1fr 1fr;
      gap: 4rem;
    }
  }

  /* Imagen visible tanto en móvil (arriba) como en desktop */
  .sub-image-preview {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    margin-bottom: 0.5rem;
  }

  @media screen and (min-width: 990px) {
    .sub-image-preview {
      position: sticky;
      top: 4rem;
      margin-bottom: 0;
      box-shadow: 0 20px 40px rgba(0,0,0,0.08);
      border-radius: 24px;
    }
  }

  .sub-image-preview img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    max-height: 350px;
  }

  @media screen and (min-width: 990px) {
    .sub-image-preview img {
      max-height: none;
    }
  }

  .sub-panel {
    background: #FFFFFF;
    padding: 2rem;
    border-radius: 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
  }

  @media screen and (min-width: 750px) {
    .sub-panel {
      padding: 3rem;
    }
  }

  .sub-title {
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .sub-subtitle {
    font-size: 1.3rem;
    opacity: 0.75;
    margin-bottom: 2rem;
  }

  .step-label {
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Selector de Planes */
  .plans-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2.5rem;
  }

  .plan-card {
    flex: 1 1 calc(50% - 0.4rem);
    min-width: 110px;
    border: 2px solid rgba(0,0,0,0.08);
    border-radius: 14px;
    padding: 1.2rem 0.6rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease-in-out;
    background: #FAFAFA;
    position: relative;
    user-select: none;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    .plan-card {
      flex: 1 1 calc(25% - 0.8rem);
    }
  }

  .plan-card:hover {
    border-color: rgba(107, 74, 47, 0.4);
  }

  .plan-card.active {
    border-color: {{ section.settings.accent_color }};
    background: #FFFFFF;
    box-shadow: 0 8px 20px rgba(107, 74, 47, 0.15);
  }

  .plan-duration {
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 0.2rem;
    pointer-events: none;
  }

  .plan-caps {
    font-size: 1rem;
    opacity: 0.6;
    margin-bottom: 0.8rem;
    pointer-events: none;
  }

  .plan-price-current {
    font-size: 1.3rem;
    font-weight: 900;
    color: {{ section.settings.accent_color }};
    pointer-events: none;
  }

  .plan-badge-discount {
    background: {{ section.settings.accent_color }};
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 8px;
    display: inline-block;
    margin-top: 0.4rem;
    pointer-events: none;
  }

  /* Personalizador de Cápsulas con Stepper */
  .capsule-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
    margin-bottom: 0.8rem;
    background: #FAFAFA;
  }

  .capsule-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .capsule-thumb {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 50%;
    background: #23160F;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: bold;
    font-size: 0.9rem;
    overflow: hidden;
    flex-shrink: 0;
  }

  .capsule-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .capsule-name {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0;
  }

  .capsule-desc {
    font-size: 1rem;
    opacity: 0.65;
    margin: 0;
    line-height: 1.3;
  }

  .stepper-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: #FFFFFF;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 8px;
    padding: 0.2rem 0.5rem;
    flex-shrink: 0;
  }

  .stepper-btn {
    background: none;
    border: none;
    font-size: 1.4rem;
    font-weight: bold;
    cursor: pointer;
    color: {{ section.settings.text_color }};
    padding: 0 0.3rem;
  }

  .stepper-btn:active {
    transform: scale(0.9);
  }

  .stepper-input {
    width: 30px;
    text-align: center;
    border: none;
    font-size: 1.2rem;
    font-weight: 800;
    background: transparent;
  }

  .frequency-select {
    width: 100%;
    padding: 1.1rem;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.15);
    background: #FAFAFA;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 2rem;
  }

  .checkout-btn {
    width: 100%;
    background-color: {{ section.settings.button_color }};
    color: #FFFFFF;
    padding: 1.4rem;
    border-radius: 12px;
    text-align: center;
    font-size: 1.4rem;
    font-weight: 800;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.2s ease;
    box-shadow: 0 10px 25px rgba(35, 22, 15, 0.2);
  }

  .checkout-btn:hover {
    opacity: 0.95;
    transform: translateY(-2px);
  }
{%- endstyle -%}

<div class="subscriptions-section-{{ section.id }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="sub-builder-container">
      
      <!-- Imagen arriba en móviles, lateral en desktop -->
      <div class="sub-image-preview">
        {%- if section.settings.main_image != blank -%}
          {{ section.settings.main_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: 'Caja de suscripción Montecapra' }}
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0658/5832/2592/files/montecapra-subscription-banner.png" alt="Suscripción Montecapra" loading="lazy">
        {%- endif -%}
      </div>

      <!-- Panel Interactivo de Suscripción -->
      <div class="sub-panel">
        <h2 class="sub-title">{{ section.settings.title | default: 'Tu café favorito, siempre listo' }}</h2>
        <p class="sub-subtitle">{{ section.settings.subtitle | default: 'Suscríbete y recibe MonteCapra en la puerta de tu casa.' }}</p>

        <!-- PASO 1: Elige tu plan -->
        <div class="step-label">
          <span>1. Elige tu plan</span>
        </div>
        
        <div class="plans-grid" id="plansGrid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'plan' -%}
              <div class="plan-card {% if forloop.index == 1 %}active{% endif %}" 
                   data-caps="{{ block.settings.capsules_total | strip }}" 
                   data-price="{{ block.settings.price_total | strip }}" 
                   {{ block.shopify_attributes }}>
                <div class="plan-duration">{{ block.settings.title }}</div>
                <div class="plan-caps">{{ block.settings.subtitle_caps }}</div>
                <div class="plan-price-current">${{ block.settings.price_total | strip }}</div>
                {%- if block.settings.badge_text != blank and block.settings.badge_text != '-' -%}
                  <div class="plan-badge-discount">{{ block.settings.badge_text }}</div>
                {%- else -%}
                  <div style="height: 20px;"></div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- PASO 2: Personaliza tus cápsulas -->
        <div class="step-label">
          <span>2. Personaliza tus cápsulas</span>
          <span id="totalCapsuleIndicator" style="font-size: 1.1rem; font-weight: 600; color: {{ section.settings.accent_color }};">Total ciclo: 10 cápsulas</span>
        </div>

        <!-- Renderizar Variedades Dinámicas desde Bloques -->
        {%- assign variety_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'variety' -%}
            {%- assign variety_index = variety_index | plus: 1 -%}
            <div class="capsule-row" {{ block.shopify_attributes }}>
              <div class="capsule-info">
                <div class="capsule-thumb">
                  {%- if block.settings.variety_image != blank -%}
                    {{ block.settings.variety_image | image_url: width: 100 | image_tag: loading: 'lazy' }}
                  {%- else -%}
                    {{ block.settings.variety_letter | default: 'C' }}
                  {%- endif -%}
                </div>
                <div>
                  <p class="capsule-name">{{ block.settings.variety_name }}</p>
                  <p class="capsule-desc">{{ block.settings.variety_desc }}</p>
                </div>
              </div>
              <div class="stepper-controls">
                <button type="button" class="stepper-btn minus" data-target="capsVariety{{ variety_index }}">-</button>
                <input type="text" id="capsVariety{{ variety_index }}" class="stepper-input variety-input" value="{{ block.settings.default_qty | default: 0 }}" readonly>
                <button type="button" class="stepper-btn plus" data-target="capsVariety{{ variety_index }}">+</button>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <!-- PASO 3: Frecuencia de entrega -->
        <div class="step-label" style="margin-top: 2rem;">
          <span>3. Frecuencia de entrega</span>
        </div>
        <select class="frequency-select" id="frequencySelect">
          <option value="mes">Entrega cada mes</option>
          <option value="completo">Pedido completo</option>
        </select>

        <!-- Botón de Suscripción Masivo Dinámico -->
        <button type="button" class="checkout-btn" id="checkoutButton">
          Suscribirme | <span id="finalButtonPrice">$29.000</span> →
        </button>

      </div>
    </div>
  </div>
</div>

<!-- Lógica JavaScript -->
<script>
  (function() {
    function initSubscriptions() {
      const planCards = document.querySelectorAll(".plan-card");
      const indicator = document.getElementById("totalCapsuleIndicator");
      const finalPriceSpan = document.getElementById("finalButtonPrice");
      const varietyInputs = document.querySelectorAll(".variety-input");
      const stepperBtns = document.querySelectorAll(".stepper-btn");

      if (!planCards.length || !varietyInputs.length) return;

      let currentRequiredCaps = 10; 
      let currentPlanPrice = 29000;

      const defaultActive = document.querySelector(".plan-card.active") || planCards[0];
      if (defaultActive) {
        currentRequiredCaps = parseInt(defaultActive.getAttribute("data-caps"), 10) || 10;
        currentPlanPrice = parseInt(defaultActive.getAttribute("data-price"), 10) || 29000;
        if (finalPriceSpan) finalPriceSpan.textContent = "$" + currentPlanPrice.toLocaleString("es-CO");
        if (indicator) indicator.textContent = `Total ciclo: ${currentRequiredCaps} cápsulas`;
      }

      function getTotalSum() {
        let sum = 0;
        varietyInputs.forEach(input => {
          sum += parseInt(input.value, 10) || 0;
        });
        return sum;
      }

      planCards.forEach(card => {
        card.onclick = function() {
          planCards.forEach(c => c.classList.remove("active"));
          this.classList.add("active");

          currentRequiredCaps = parseInt(this.getAttribute("data-caps"), 10) || 10;
          currentPlanPrice = parseInt(this.getAttribute("data-price"), 10) || 29000;

          if (indicator) indicator.textContent = `Total ciclo: ${currentRequiredCaps} cápsulas`;
          if (finalPriceSpan) finalPriceSpan.textContent = "$" + currentPlanPrice.toLocaleString("es-CO");

          let count = varietyInputs.length;
          let portion = currentRequiredCaps / count;
          let assignedTotal = 0;

          varietyInputs.forEach((input, idx) => {
            let val = Math.round(portion / 10) * 10;
            if (idx === count - 1) {
              val = currentRequiredCaps - assignedTotal;
            }
            if (val < 0) val = 0;
            input.value = val;
            assignedTotal += val;
          });
        };
      });

      stepperBtns.forEach(btn => {
        btn.onclick = function(e) {
          e.preventDefault();
          const targetInput = document.getElementById(this.getAttribute("data-target"));
          if (!targetInput) return;

          let val = parseInt(targetInput.value, 10) || 0;
          let currentSum = getTotalSum();

          if(this.classList.contains("plus")) {
            if (currentSum + 10 > currentRequiredCaps) {
              return; 
            }
            val += 10;
          } else {
            val = Math.max(0, val - 10);
          }

          targetInput.value = val;

          let newSum = getTotalSum();

          const activeCard = document.querySelector(".plan-card.active");
          let basePrice = activeCard ? parseInt(activeCard.getAttribute("data-price"), 10) : 29000;
          let baseCaps = activeCard ? parseInt(activeCard.getAttribute("data-caps"), 10) : 10;

          if (baseCaps > 0) {
            let unitPrice = basePrice / baseCaps;
            currentPlanPrice = Math.round(newSum * unitPrice);
          }

          if (finalPriceSpan) finalPriceSpan.textContent = "$" + currentPlanPrice.toLocaleString("es-CO");

          if (indicator) {
            if (newSum !== currentRequiredCaps) {
              indicator.style.color = "#d32f2f";
              indicator.textContent = `Atención: Tienes ${newSum} de ${currentRequiredCaps} cápsulas`;
            } else {
              indicator.style.color = "{{ section.settings.accent_color }}";
              indicator.textContent = `Total ciclo: ${newSum} cápsulas`;
            }
          }
        };
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSubscriptions);
    } else {
      initSubscriptions();
    }
  })();
</script>

